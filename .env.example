# Supabase（只提交 anon public key，切勿提交 service_role）
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# 可选：CI 备份时使用，只放在 GitHub Secrets / 本机环境变量中
# SUPABASE_DB_URL=postgresql://postgres:...@db.your-project-ref.supabase.co:5432/postgres
# SUPABASE_SERVICE_ROLE_KEY=...
